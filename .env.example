# ---------------------------------------------------------------------------
# Risk, Fraud & Regulatory Intelligence Copilot - environment template
#
# Copy to .env and fill in. .env is gitignored (.gitignore line: .env*).
# NEVER commit real credentials. This template is the only tracked file here.
#
#   cp .env.example .env
#
# With no credentials at all the app still runs: it selects the sqlite engine
# and the UI shows "Fallback mode: local engine".
# ---------------------------------------------------------------------------

# --- Snowflake account -----------------------------------------------------
# Required to use the Snowflake engine. Leave blank for the local fallback.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=RISK_COPILOT_ROLE
SNOWFLAKE_WAREHOUSE=RISK_WH
SNOWFLAKE_DATABASE=RISK_INTELLIGENCE

# --- Authentication (pick ONE) ---------------------------------------------

# Option A: programmatic OAuth token (preferred - shortest lived)
SNOWFLAKE_TOKEN=

# Option B: key-pair (recommended for a service account). Point at the .p8 file
# and keep the passphrase out of git.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Option C: password. Demo accounts only - the UI labels this auth method.
SNOWFLAKE_PASSWORD=

# --- Cortex ----------------------------------------------------------------
# Models are pinned rather than left to auto-select, so a narrative drafted in
# the demo is reproducible in the audit trail.
SNOWFLAKE_CORTEX_ANALYST_MODEL=claude-3-5-sonnet
SNOWFLAKE_CORTEX_COMPLETE_MODEL=claude-3-5-sonnet
SNOWFLAKE_CORTEX_AGENT_NAME=RISK_COMPLIANCE_AGENT

# --- Action connectors (Phase 4) ------------------------------------------
# When unset or unreachable, connectors fall back to SIMULATED and every
# receipt is labelled SIMULATED in the UI and the audit log.

# Jira. JIRA_ENABLED=true switches the connector from simulated to live.
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=RISK
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack incoming webhook. SLACK_ENABLED=true switches to live.
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#risk-alerts

# --- Render keep-alive (Phase B12) -----------------------------------------
# Render free instances sleep after 15 min idle. Either ping /healthz from an
# external cron, or point this at your instance URL.
# KEEPALIVE_URL=https://your-app.onrender.com/healthz

# --- Demo runtime ----------------------------------------------------------
# demo = 200 customers (deployed default). full = 600 customers.
RISK_PROFILE=demo
RISK_SEED=42
